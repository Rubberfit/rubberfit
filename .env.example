# rema-portal — local development environment
#
# Copy to `.env.local` and fill with real values from 1Password / Vercel.
# Never commit a populated copy. ARC-138 added the architectural test
# `tests/architecture/env-example-completeness.test.ts` that fails the
# build if a new `process.env.X` reference lands without an entry below.

# ---------------------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------------------
# Project URL + anonymous key. Public — embedded in the browser bundle.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key. SECRET. Bypasses RLS; only used by `makeAdminClient`
# in server-only paths (admin route handlers, e2e fixtures). Never ship
# this to the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# ---------------------------------------------------------------------------
# Email (Resend) — required for transactional email + low-stock alerts
# ---------------------------------------------------------------------------
# SECRET. Used by emailService and the health check that verifies the
# email pipeline is reachable.
RESEND_API_KEY=your_resend_api_key_here

# Email envelope addresses. Public-ish — show up in `From` and
# `Reply-To` headers on outgoing transactional email. Both fall back
# to defaults inside emailService if unset.
SENDER_EMAIL=notifications@arcandanchor.com
REPLY_TO_EMAIL=support@arcandanchor.com

# ---------------------------------------------------------------------------
# Tax (Ziptax) — required for PO supplier-address tax preview
# ---------------------------------------------------------------------------
# SECRET, BILLED. Iteration-style abuse exhausts the monthly quota and
# breaks PO tax preview for everyone. Locked down to authenticated
# callers in ARC-134; rate-limit defense-in-depth tracked in ARC-142.
ZIPTAX_API_KEY=your_ziptax_api_key_here

# ---------------------------------------------------------------------------
# Backend (Rust nesting / API service)
# ---------------------------------------------------------------------------
# Base URL for the Rust backend the v2 bridge forwards to. Internal —
# treat as semi-sensitive (an attacker who knows it can probe directly
# instead of going through the Next.js bridge layer).
RF_API_URL=https://your-rust-backend.example.com

# ---------------------------------------------------------------------------
# Health monitoring + cron
# ---------------------------------------------------------------------------
# Shared secret that gates `/api/admin/health/cron`. SECRET. Vercel
# Cron sends it in the `Authorization: Bearer <CRON_SECRET>` header.
CRON_SECRET=your_cron_secret_here

# Slack webhook for health alerts. SECRET-ish — anyone with the URL can
# post to the channel. Optional: leave unset to disable Slack alerting.
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/here

# Comma-separated list of recipients for health-alert emails (Vercel
# Cron → Resend pipeline). Optional: leave unset to disable email
# alerting (Slack still fires).
ADMIN_ALERT_EMAIL=ops@arcandanchor.com

# ---------------------------------------------------------------------------
# Public URLs (used in browser bundle + transactional email links)
# ---------------------------------------------------------------------------
# Canonical app URL embedded in transactional email links. Public.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional fallback for `app/lib/app-url.ts` when the request origin is
# not browser-derivable (server-rendered emails, scripts). Public.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Engine + feature flags
# ---------------------------------------------------------------------------
# Toggles the Rust pack-cli binary path. Set to `false` to force the
# legacy TS path (none today — kept as the documented escape hatch
# referenced in docs/superpowers/specs/2026-04-17-s2-rust-engine-design.md).
USE_RUST_ENGINE=true

# Per-domain feature flags for the Rust v2 routes. Public — read by the
# browser to choose between the v1 and v2 endpoints. Set to `true` to
# route the corresponding domain through the Rust backend.
NEXT_PUBLIC_USE_RUST_CUT_HISTORY=false
NEXT_PUBLIC_USE_RUST_PROCUREMENT=false
NEXT_PUBLIC_USE_RUST_INVENTORY=false

# ---------------------------------------------------------------------------
# Scripts (one-shot maintenance / seed scripts)
# ---------------------------------------------------------------------------
# Email of the demo user that `scripts/seed-barcodes.ts` upserts barcode
# fixtures for. Optional — only used when running the seed script
# locally; not read at runtime.
DEMO_USER_EMAIL=demo@arcandanchor.com

# ---------------------------------------------------------------------------
# Stripe (added in Stripe rollout PR 1 — used by PRs 2–6)
# ---------------------------------------------------------------------------
# Secret key. SECRET. Used by server-side code in
# `scripts/stripe-setup.ts` (catalog) and `app/api/stripe/webhook/route.ts`
# (event ingest) and any server action that creates Checkout / Portal
# sessions. Test mode prefix is `sk_test_…`; live prefix is `sk_live_…`.
# Founder swaps to live at launch.
STRIPE_SECRET_KEY=sk_test_replace_me

# Publishable key. Public. Currently unused (Stripe Checkout is hosted),
# but kept in the bundle so the future in-app Stripe.js elements (if we
# ever inline a card form) can read it without a redeploy.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Webhook signing secret. SECRET. Issued by Stripe when you register the
# webhook endpoint in Dashboard → Developers → Webhooks. PR 3 creates the
# endpoint via API and surfaces the secret; paste it here. Each
# environment (test mode, live mode, local CLI `stripe listen`) has its
# own secret — do not share across envs.
STRIPE_WEBHOOK_SECRET=whsec_replace_me
