{
  "openapi": "3.1.0",
  "info": {
    "title": "RF backend API",
    "description": "HTTP surface for the Rust RF backend. Frontend calls go via Next.js route handlers at `/api/v2/*`, which bridge the Supabase session cookie to a bearer JWT before forwarding here.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v2/cuts/favorites": {
      "get": {
        "tags": [
          "cuts"
        ],
        "operationId": "list_favorites",
        "responses": {
          "200": {
            "description": "Favorited cut-history entries",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CutHistoryDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "500": {
            "description": "Downstream infrastructure failure"
          }
        },
        "security": [
          {
            "supabase_jwt": []
          }
        ]
      }
    },
    "/api/v2/cuts/history": {
      "get": {
        "tags": [
          "cuts"
        ],
        "operationId": "list_history",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "description": "Page size. Clamped to 200 server-side; defaults to 50 when omitted.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based offset from the newest entry.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "since",
            "in": "query",
            "description": "Lower bound on `cut_date` (ISO-8601, inclusive).",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "until",
            "in": "query",
            "description": "Upper bound on `cut_date` (ISO-8601, inclusive).",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cut-history entries, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CutHistoryDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "500": {
            "description": "Downstream infrastructure failure"
          }
        },
        "security": [
          {
            "supabase_jwt": []
          }
        ]
      }
    },
    "/api/v2/cuts/history/{id}": {
      "get": {
        "tags": [
          "cuts"
        ],
        "operationId": "get_history_item",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Cut-history row id",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The cut-history entry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CutHistoryDto"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "404": {
            "description": "Row not found or hidden by RLS"
          },
          "500": {
            "description": "Downstream infrastructure failure"
          }
        },
        "security": [
          {
            "supabase_jwt": []
          }
        ]
      }
    },
    "/health": {
      "get": {
        "tags": [
          "meta"
        ],
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Service liveness",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CutHistoryDto": {
        "type": "object",
        "description": "Response DTO — thin wrapper over the domain entry. Separated from\n`CutHistoryEntry` so the HTTP contract can evolve independently\nof domain schema. Today the mapping is 1:1; renaming / derived\nfields will land here first when we start splitting concerns.",
        "required": [
          "id",
          "material_id",
          "part_id",
          "cut_length",
          "cut_width",
          "cut_thickness",
          "cut_amount",
          "parts_completed",
          "material_used_sqft",
          "reusable_offset_sqft",
          "scrap_sqft",
          "fab_score",
          "cut_pieces"
        ],
        "properties": {
          "created_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "cut_amount": {
            "type": "integer",
            "format": "int32"
          },
          "cut_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "cut_length": {
            "type": "number",
            "format": "double"
          },
          "cut_pieces": {
            "type": "integer",
            "format": "int32"
          },
          "cut_thickness": {
            "type": "number",
            "format": "double"
          },
          "cut_width": {
            "type": "number",
            "format": "double"
          },
          "fab_score": {
            "type": "number",
            "format": "double"
          },
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "material_id": {
            "type": "integer",
            "format": "int32"
          },
          "material_used_sqft": {
            "type": "number",
            "format": "double"
          },
          "part_custom_height": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "part_custom_width": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "part_id": {
            "type": "integer",
            "format": "int32"
          },
          "part_selected_label": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "part_selected_size": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "integer",
              "format": "int32"
            }
          },
          "part_selected_size_text": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "parts_completed": {
            "type": "integer",
            "format": "int32"
          },
          "reusable_offset_sqft": {
            "type": "number",
            "format": "double"
          },
          "scrap_sqft": {
            "type": "number",
            "format": "double"
          },
          "updated_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "user_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "properties": {
          "status": {
            "type": "string"
          },
          "version": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "supabase_jwt": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase-issued RS256 JWT. Forwarded to PostgREST so RLS scopes rows to the caller."
      }
    }
  },
  "tags": [
    {
      "name": "meta",
      "description": "Service metadata + health"
    },
    {
      "name": "cuts",
      "description": "Cut-history + favorites"
    },
    {
      "name": "inventory",
      "description": "Rolls, material types, suppliers"
    }
  ]
}
