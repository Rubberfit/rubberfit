  "components": {
    "schemas": {
      "CreateMaterialTypeBody": {
        "type": "object",
        "description": "Request body for POST — mandatory `name`, everything else\noptional. The handler validates constraints through the use\ncase; the adapter maps a DB unique violation to a stable\n`DUPLICATE_NAME` conflict code.",
        "required": [
          "name"
        ],
        "properties": {
          "default_cost": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
