    "/api/v2/inventory/suppliers": {
      "get": {
        "tags": [
          "inventory"
        ],
        "operationId": "list_suppliers",
        "parameters": [
          {
            "name": "active",
            "in": "query",
            "description": "When set, only return suppliers matching the given active flag.",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "preferred",
            "in": "query",
            "description": "When set, only return suppliers matching the given preferred flag.",
            "required": false,
            "schema": {
              "type": [
                "boolean",
                "null"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "description": "ILIKE search across name / contact_person / email / city.",
            "required": false,
            "schema": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "description": "Page size. Clamped to 200 server-side.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          },
          {
            "name": "offset",
            "in": "query",
            "description": "Zero-based offset.",
            "required": false,
            "schema": {
              "type": [
                "integer",
                "null"
              ],
              "format": "int32",
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Suppliers, preferred first then alphabetical",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/SupplierDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "500": {
            "description": "Downstream infrastructure failure"
          }
        },
        "security": [
