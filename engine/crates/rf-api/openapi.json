        "security": [
          {
            "supabase_jwt": []
          }
        ]
      },
      "post": {
        "tags": [
          "inventory"
        ],
        "operationId": "create_material_type",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateMaterialTypeBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MaterialTypeDto"
                }
              }
            }
          },
          "400": {
            "description": "Validation failed"
          },
          "401": {
            "description": "Missing or invalid bearer token"
          },
          "409": {
            "description": "Duplicate name — `DUPLICATE_NAME` code in body"
          },
          "500": {
            "description": "Downstream infrastructure failure"
          }
        },
        "security": [
          {
            "supabase_jwt": []
          }
        ]
      }
    },
