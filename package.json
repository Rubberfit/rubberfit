{
  "name": "rema-portal",
  "version": "1.0.0-beta.1",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "vercel-build": "next build",
    "lint": "eslint src/ nesting/ di/ config/",
    "lint:fix": "eslint src/ nesting/ di/ config/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"nesting/**/*.{ts,tsx,js,jsx,json,css,md}\" \"di/**/*.{ts,tsx,js,jsx,json,css,md}\" \"config/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"nesting/**/*.{ts,tsx,js,jsx,json,css,md}\" \"di/**/*.{ts,tsx,js,jsx,json,css,md}\" \"config/**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "next start",
    "generate:presets": "ts-node --compiler-options '{\"module\":\"CommonJS\"}' src/infrastructure/services/scripts/generate-theme-presets.ts",
    "supabase:start": "cd src/infrastructure/supabase && supabase start",
    "supabase:stop": "cd src/infrastructure/supabase && supabase stop",
    "supabase:reset": "cd src/infrastructure/supabase && supabase db reset"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.6",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.38.0",
    "@types/jspdf": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clipper-lib": "^6.4.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.7.0",
    "next": "^16.2.3",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^2.15.4",
    "resend": "^6.10.0",
    "simple-icons": "^16.15.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tsyringe": "^4.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.3",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "postcss": "^8.5.9",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0"
  }
}
