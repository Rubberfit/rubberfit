{
  "name": "rema-portal",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "predev": "npm run build:engine",
    "prebuild": "npm run build:engine",
    "build": "next build",
    "vercel-build": "next build",
    "pretest": "npm run build:engine",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:parity": "vitest run tests/packing/parity",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "eslint src/ nesting/ di/ config/ proxy.ts",
    "lint:fix": "eslint src/ nesting/ di/ config/ proxy.ts --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"nesting/**/*.{ts,tsx,js,jsx,json,css,md}\" \"di/**/*.{ts,tsx,js,jsx,json,css,md}\" \"config/**/*.{ts,tsx,js,jsx,json,css,md}\" proxy.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"nesting/**/*.{ts,tsx,js,jsx,json,css,md}\" \"di/**/*.{ts,tsx,js,jsx,json,css,md}\" \"config/**/*.{ts,tsx,js,jsx,json,css,md}\" proxy.ts",
    "typecheck": "tsc --noEmit --pretty false",
    "start": "next start",
    "seed:demo": "node --experimental-strip-types --no-warnings src/infrastructure/scripts/seed-demo-data.ts",
    "seed:barcodes": "node --experimental-strip-types --no-warnings src/infrastructure/scripts/seed-barcodes.ts",
    "supabase:start": "cd src/infrastructure/supabase && supabase start",
    "supabase:stop": "cd src/infrastructure/supabase && supabase stop",
    "supabase:reset": "cd src/infrastructure/supabase && supabase db reset",
    "build:engine": "cargo build --release --manifest-path engine/Cargo.toml",
    "build:engine:dev": "cargo build --manifest-path engine/Cargo.toml",
    "test:rust": "cargo test --manifest-path engine/Cargo.toml",
    "fmt:rust": "cargo fmt --manifest-path engine/Cargo.toml --all",
    "clippy:rust": "cargo clippy --manifest-path engine/Cargo.toml --all-targets -- -D warnings",
    "openapi:dump": "cargo run --quiet --manifest-path engine/Cargo.toml -p rf-api --bin dump-openapi > engine/crates/rf-api/openapi.json",
    "openapi:types": "openapi-typescript engine/crates/rf-api/openapi.json --output src/infrastructure/api-client/types.ts",
    "openapi:check": "bash -c 'tmp=$(mktemp) && cargo run --quiet --manifest-path engine/Cargo.toml -p rf-api --bin dump-openapi > \"$tmp\" && diff -u engine/crates/rf-api/openapi.json \"$tmp\" && rm \"$tmp\"'",
    "stripe:setup": "node scripts/stripe-setup.mjs",
    "stripe:webhook-register": "node scripts/stripe-webhook-register.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@react-email/components": "^1.0.8",
    "@react-email/render": "^2.0.6",
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.38.0",
    "@vercel/speed-insights": "^2.0.0",
    "bwip-js": "^4.9.2",
    "class-variance-authority": "^0.7.1",
    "clipper-lib": "^6.4.2",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "jspdf": "^4.2.1",
    "konva": "^10.2.5",
    "lucide-react": "^1.7.0",
    "next": "^16.2.6",
    "next-intl": "^4.12.0",
    "next-themes": "^0.4.6",
    "openapi-fetch": "^0.14.1",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-day-picker": "^9.13.2",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.72.1",
    "react-konva": "^19.2.3",
    "react-resizable-panels": "^4.9.0",
    "recharts": "^2.15.4",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.10.0",
    "sat": "^0.9.0",
    "simple-icons": "^16.15.0",
    "sonner": "^2.0.7",
    "stripe": "^22.1.1",
    "tailwind-merge": "^3.5.0",
    "tsyringe": "^4.10.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@next/eslint-plugin-next": "^16.2.3",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.19.11",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/ui": "^4.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv": "^17.3.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.4.0",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.4.4",
    "postcss": "^8.5.11",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.2.2",
    "ts-node": "^10.9.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.58.0",
    "vercel-rust": "4.0.11",
    "vitest": "^4.1.4"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    },
    "@swc/helpers": "0.5.21"
  }
}
