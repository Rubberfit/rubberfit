# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# Testing
coverage/

# Playwright
playwright-report/
test-results/
blob-report/
playwright/.cache/

# Production builds
build/
dist/
electron-dist/
out/
.next/

# Environment files - CRITICAL TO EXCLUDE
.env
.env.local
.env.production
.env.development
.env*.local
*.env

# Supabase local development.
# Glob covers any future supabase config dirs (worktrees, sibling tools).
# Root-anchored explicit paths are belt-and-suspenders for the two known
# locations — top-level and the nested infra path the CLI also drops
# state into (project_ref, pooler URL, etc.).
**/supabase/.temp/
**/supabase/.branches/
**/supabase/.env
**/supabase/.env.local
/src/infrastructure/supabase/.temp/

# OS files
.DS_Store
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Security files
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx

# Shell scripts that might contain secrets
*.sh
# …except operator scripts that only read secrets from env vars —
# these are explicitly audited and safe to commit.
!engine/crates/rf-api/scripts/smoke.sh
!.claude/scripts/*.sh
# Claude Code session hooks live in .claude/hooks/ by convention.
# They run on session lifecycle events (Stop, etc.) and must be
# committed so the project's hook config is reproducible. No secrets.
!.claude/hooks/*.sh

# Internal planning docs — working files for us, not part of the
# repo. Specs + benchmarks under docs/superpowers/ stay tracked;
# only per-task plans are local-only.
docs/superpowers/plans/

# Per-session Claude Code scratch — handoffs, research, worktrees,
# roadmaps, and per-sprint plan drafts (S5+). All local-only: never
# commit these. Keeps public log focused on shipped code. Roadmap
# globs are scoped under .claude/ so `.claude/roadmap*` or
# `.claude/**/roadmap.md` match but repo-wide `ROADMAP.md` at a
# product-docs path would still be committable.
.claude/handoff/
.claude/research/
.claude/worktrees/
.claude/tmp/
.claude/scratch/
.claude/roadmap*
.claude/**/ROADMAP.md
.claude/**/roadmap.md
.claude/**/roadmap/
# Per-user permission state — every dev's allow-list differs.
.claude/settings.local.json

# TypeScript
*.tsbuildinfo

# Refactor toolkit — generated API snapshots are build artifacts, not source.
# The snapshots/ directory itself is tracked via .gitkeep so the output path exists.
scripts/refactor/snapshots/*.json
next-env.d.ts

# Vercel
.vercel

# Electron
electron-dist/
dist-electron/
release/

# Backup files
*.backup
*.bak

# Rust engine build artefacts
engine/target/

# Root cargo target dir (Vercel Rust functions — `api/v2/pack.rs` etc.)
/target/

# Test-output PDFs at the repo root (jsPDF's `doc.save(name)` lands here when
# tests run from the repo root). Root-scoped on purpose so committed docs
# under `docs/`, design specs, or any future tracked PDF asset stay
# trackable. CR catch on PR #238.
/*.pdf
