# Internal planning docs — working files for us, not part of the
# repo. Specs + benchmarks under docs/superpowers/ stay tracked;
# only per-task plans are local-only.
docs/superpowers/plans/

# Per-session Claude Code scratch — handoffs, research, worktrees,
# and any new S5+ plan drafts. Historical archives under archive/
# that are already tracked stay tracked; this just prevents NEW
# plan/research files from sneaking into commits.
.claude/handoff/
.claude/research/
.claude/worktrees/
.claude/tmp/
.claude/scratch/

